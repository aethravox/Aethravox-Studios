# ── AethraMail (binario separado del hub) ──────────────────────────────
# Copia este archivo a .env y ajusta lo que necesites.

# Dirección del webmail UI (HTTP, lo ve el usuario en el navegador).
AETHRAMAIL_HTTP_ADDR=127.0.0.1:8088

# Dirección de la API interna (HTTPS + mTLS, solo la usa el hub).
# El hub presenta su client cert firmado por la CA interna para conectarse.
AETHRAMAIL_API_ADDR=127.0.0.1:8449

# DB SQLite propia (totalmente separada de la del hub).
AETHRAMAIL_DB=data/aethramail.db

# Dominios internos disponibles al crear una cuenta de correo (5.3).
AETHRAMAIL_DOMAINS=shadow.sac,aethra.sac,cents.sac

# Certs mTLS (5.8). Generar con scripts/gen_certs.sh.
AETHRAMAIL_TLS_SERVER_CERT=certs/server.pem
AETHRAMAIL_TLS_SERVER_KEY=certs/server-key.pem
AETHRAMAIL_TLS_CLIENT_CA=certs/ca.pem

# Rate limiting estricto en la API interna (5.10).
# Máximo de envíos por cliente (por client cert / from_address) por minuto.
AETHRAMAIL_API_RATE_PER_MIN=60

# Nombre de la cookie de sesión del webmail.
AETHRAMAIL_COOKIE_NAME=aethramail_session

# Nivel de log.
AETHRAMAIL_LOG_LEVEL=info
